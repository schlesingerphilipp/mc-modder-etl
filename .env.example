# Google Gemini API Configuration
# Get your API key from https://aistudio.google.com/app/apikeys
GOOGLE_API_KEY=your_api_key_here

# Gemini model to use for semantic summarization
# Options: gemini-1.5-pro, gemini-1.5-flash, etc.
GEMINI_MODEL=gemini-1.5-pro

# Directory for checkpoint files (for resumable processing)
# Checkpoints are automatically saved after each commit summary
CHECKPOINT_DIR=./checkpoints

# Maximum number of retries for Gemini API calls
MAX_RETRIES=3

# Timeout for API calls in seconds
TIMEOUT_SECONDS=60

# Custom semantic summary prompt template
# Use {commit_message} and {combined_diffs} as placeholders
SEMANTIC_SUMMARY_PROMPT=You are a code review expert analyzing git commits. Given a commit message and code diffs, provide a concise semantic summary focusing on:
0. The motivation behind the changes in the sense of what changed in a greater scheme
1. The core problem being solved
2. The technical patterns or approaches used
3. The business or product impact

Commit Message:
{commit_message}

Code Changes:
{combined_diffs}

Generate a 2-3 sentence semantic summary:
